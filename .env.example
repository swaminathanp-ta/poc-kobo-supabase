# Copy to .env and fill in. setup_supabase.py writes the Supabase half for you.
# NEVER commit .env — it holds keys that bypass all row-level security.

# --- Written by setup_supabase.py ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role or sb_secret_... key>

# --- Fill in from KoboToolbox ---
KOBO_TOKEN=<Account Settings -> Security -> API key>
KOBO_ASSET_UID=<the a... id in your deployed form's URL>
KOBO_BASE_URL=https://kf.kobotoolbox.org

# --- Setup only: account-level token for the Management API ---
# https://supabase.com/dashboard/account/tokens
# setup_supabase.py offers to save this here on first run so it stops prompting.
SUPABASE_ACCESS_TOKEN=<sbp_...>
